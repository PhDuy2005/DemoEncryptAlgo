        {
            "name": "RIJNDAEL Tests",
            "item": [
                {
                    "name": "RIJNDAEL - Encrypt",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.globals.set('current_algo', 'RIJNDAEL');",
                                    "pm.globals.set('test_data', 'Hello World Encryption Test 123');",
                                    "pm.globals.set('test_key', 'MySecretKey12345');",
                                    "console.log('► Testing RIJNDAEL Encryption');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const algo = pm.globals.get('current_algo');",
                                    "const testData = pm.globals.get('test_data');",
                                    "",
                                    "// Test 1: Status code is 200",
                                    "pm.test('RIJNDAEL - Encrypt returns 200', () => {",
                                    "  pm.expect(pm.response.code).to.equal(200);",
                                    "});",
                                    "",
                                    "// Test 2: Response has required fields",
                                    "pm.test('RIJNDAEL - Encrypt response has required fields', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.expect(jsonData).to.have.property('statusCode');",
                                    "  pm.expect(jsonData).to.have.property('data');",
                                    "  pm.expect(jsonData).to.have.property('message');",
                                    "});",
                                    "",
                                    "// Test 3: Encrypted data is not empty",
                                    "pm.test('RIJNDAEL - Encrypt produces non-empty ciphertext', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.expect(jsonData.data).to.exist;",
                                    "  pm.expect(jsonData.data.length).to.be.greaterThan(0);",
                                    "  pm.expect(jsonData.data).to.not.equal(pm.globals.get('test_data'));",
                                    "});",
                                    "",
                                    "// Test 4: Save encrypted data for decryption",
                                    "pm.test('RIJNDAEL - Save encrypted data for decryption', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.globals.set('rijndael_encrypted', jsonData.data);",
                                    "  console.log('✓ RIJNDAEL encrypted data saved: ' + jsonData.data.substring(0, 30) + '...');",
                                    "});",
                                    "",
                                    "// Test 5: Error message is null",
                                    "pm.test('RIJNDAEL - Encrypt has no error', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.expect(jsonData.error).to.be.null;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"RIJNDAEL\",\n  \"feature\": \"ENCRYPT\",\n  \"data\": \"{{test_data}}\",\n  \"key\": \"{{test_key}}\",\n  \"inputType\": \"PLAIN_TEXT\",\n  \"keyInputType\": \"PLAIN_TEXT\",\n  \"outputType\": \"BASE64\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/crypto/process",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "crypto",
                                "process"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "RIJNDAEL - Decrypt",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Use encrypted data from previous request",
                                    "const encrypted = pm.globals.get('rijndael_encrypted');",
                                    "if (!encrypted) {",
                                    "  throw new Error('RIJNDAEL encrypted data not found. Run Encrypt test first.');",
                                    "}",
                                    "console.log('► Testing RIJNDAEL Decryption');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const originalData = pm.globals.get('test_data');",
                                    "",
                                    "// Test 1: Status code is 200",
                                    "pm.test('RIJNDAEL - Decrypt returns 200', () => {",
                                    "  pm.expect(pm.response.code).to.equal(200);",
                                    "});",
                                    "",
                                    "// Test 2: Decrypted data matches original",
                                    "pm.test('RIJNDAEL - Decrypt produces matching plaintext', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.expect(jsonData.data).to.equal(originalData);",
                                    "  console.log('✓ RIJNDAEL Round-trip successful');",
                                    "});",
                                    "",
                                    "// Test 3: Response has no error",
                                    "pm.test('RIJNDAEL - Decrypt has no error', () => {",
                                    "  const jsonData = pm.response.json();",
                                    "  pm.expect(jsonData.error).to.be.null;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"RIJNDAEL\",\n  \"feature\": \"DECRYPT\",\n  \"data\": \"{{rijndael_encrypted}}\",\n  \"key\": \"{{test_key}}\",\n  \"inputType\": \"BASE64\",\n  \"keyInputType\": \"PLAIN_TEXT\",\n  \"outputType\": \"PLAIN_TEXT\"\n}"
                        },
