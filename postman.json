            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RIJNDAEL\",\n  \"feature\": \"DECRYPT\",\n  \"data\": \"{{data_decrypt}}\",\n  \"key\": \"{{key}}\",\n  \"inputType\": \"BASE64\",\n  \"keyInputType\": \"PLAIN_TEXT\",\n  \"outputType\": \"PLAIN_TEXT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/crypto/process",
