  "item": [
    {
      "name": "RIJNDAEL",
      "item": [
        {
          "name": "RIJNDAEL - Encrypt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RIJNDAEL\",\n  \"feature\": \"ENCRYPT\",\n  \"data\": \"{{data_encrypt}}\",\n  \"key\": \"{{key}}\",\n  \"inputType\": \"PLAIN_TEXT\",\n  \"keyInputType\": \"PLAIN_TEXT\",\n  \"outputType\": \"BASE64\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/crypto/process",
              "host": ["{{base_url}}"],
              "path": ["api", "crypto", "process"]
            }
          },
          "response": []
        },
        {
          "name": "RIJNDAEL - Decrypt",
